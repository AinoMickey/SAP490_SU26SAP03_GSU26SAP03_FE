<mvc:View
    controllerName="zuprpt.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    displayBlock="true"
>
    <Page
        id="mainPage"
        title="Upload Analytics"
        showHeader="true"
        class="sapUiContentPadding"
    >
        <content>
            <Title
                id="_mainTitle"
                text="Chọn báo cáo"
                level="H3"
                class="sapUiMediumMarginBegin sapUiSmallMarginTopBottom"
            />

            <HBox
                id="_cardBox"
                wrap="Wrap"
                class="sapUiSmallMarginBegin"
            >
                <f:Card
                    id="_cardFI"
                    class="sapUiTinyMargin"
                    width="20rem"
                >
                    <f:header>
                        <card:Header
                            xmlns:card="sap.f.cards"
                            title="FI Upload Analytics"
                            subtitle="Chứng từ kế toán đã post"
                            iconSrc="sap-icon://money-bills"
                            iconDisplayShape="Square"
                        />
                    </f:header>
                    <f:content>
                        <VBox id="_fiContent" class="sapUiSmallMargin">
                            <Text id="_fiDesc" text="Thống kê, lọc và xuất Excel các chứng từ FI đã upload." class="sapUiTinyMarginBottom" />
                            <Button id="btnFI" text="Mở" type="Emphasized" press="onPressFiRpt" icon="sap-icon://navigation-right-arrow" width="100%" />
                        </VBox>
                    </f:content>
                </f:Card>

                <f:Card
                    id="_cardPP"
                    class="sapUiTinyMargin"
                    width="20rem"
                >
                    <f:header>
                        <card:Header
                            xmlns:card="sap.f.cards"
                            title="PP Upload Analytics"
                            subtitle="Lệnh sản xuất đã tạo"
                            iconSrc="sap-icon://Chart-Tree-Map"
                            iconDisplayShape="Square"
                        />
                    </f:header>
                    <f:content>
                        <VBox id="_ppContent" class="sapUiSmallMargin">
                            <Text id="_ppDesc" text="Thống kê, lọc và xuất Excel các lệnh sản xuất đã upload." class="sapUiTinyMarginBottom" />
                            <Button id="btnPP" text="Mở" type="Emphasized" press="onPressPpRpt" icon="sap-icon://navigation-right-arrow" width="100%" />
                        </VBox>
                    </f:content>
                </f:Card>

                <f:Card
                    id="_cardGR"
                    class="sapUiTinyMargin"
                    width="20rem"
                >
                    <f:header>
                        <card:Header
                            xmlns:card="sap.f.cards"
                            title="GR Upload Analytics"
                            subtitle="Phiếu nhập kho đã upload"
                            iconSrc="sap-icon://inventory"
                            iconDisplayShape="Square"
                        />
                    </f:header>
                    <f:content>
                        <VBox id="_grContent" class="sapUiSmallMargin">
                            <Text id="_grDesc" text="Theo dõi trạng thái GR, lọc theo Status và ngày." class="sapUiTinyMarginBottom" />
                            <Button id="btnGR" text="Mở" type="Emphasized" press="onPressGrRpt" icon="sap-icon://navigation-right-arrow" width="100%" />
                        </VBox>
                    </f:content>
                </f:Card>

                <f:Card
                    id="_cardKPI"
                    class="sapUiTinyMargin"
                    width="20rem"
                >
                    <f:header>
                        <card:Header
                            xmlns:card="sap.f.cards"
                            title="Upload KPI Dashboard"
                            subtitle="Tổng quan GR + FI + PP"
                            iconSrc="sap-icon://kpi-managing-my-area"
                            iconDisplayShape="Square"
                        />
                    </f:header>
                    <f:content>
                        <VBox id="_kpiContent" class="sapUiSmallMargin">
                            <Text id="_kpiDesc" text="KPI hợp nhất: số lô theo trạng thái, tỷ lệ thành công/lỗi theo loại chứng từ, thời gian xử lý." class="sapUiTinyMarginBottom" />
                            <Button id="btnKPI" text="Mở" type="Emphasized" press="onPressKpiRpt" icon="sap-icon://navigation-right-arrow" width="100%" />
                        </VBox>
                    </f:content>
                </f:Card>
            </HBox>

            <Panel
                id="_guidePanel"
                headerText="Hướng dẫn nhanh"
                expandable="true"
                expanded="true"
                class="sapUiSmallMargin"
                width="auto"
            >
                <content>
                    <List
                        id="_guideList"
                        showSeparators="Inner"
                    >
                        <StandardListItem
                            id="_g1"
                            title="1. Chọn báo cáo"
                            description="Chọn GR Upload Analytics hoặc Upload KPI Dashboard."
                            icon="sap-icon://choropleth-chart"
                        />
                        <StandardListItem
                            id="_g2"
                            title="2. Lọc dữ liệu"
                            description="Mặc định tải 30 ngày gần nhất theo Posting Date. Điều chỉnh bộ lọc rồi bấm Go."
                            icon="sap-icon://filter"
                        />
                        <StandardListItem
                            id="_g3"
                            title="3. Xem KPI + bảng"
                            description="KPI tính trên đúng tập dữ liệu đang lọc."
                            icon="sap-icon://kpi-managing-my-area"
                        />
                        <StandardListItem
                            id="_g4"
                            title="4. Xuất Excel"
                            description="File gồm sheet Summary (tiêu chí + KPI) và sheet Data."
                            icon="sap-icon://excel-attachment"
                        />
                    </List>
                </content>
            </Panel>
        </content>
    </Page>
</mvc:View>
