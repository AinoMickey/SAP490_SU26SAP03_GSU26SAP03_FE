<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog id="grItemDetailDialog"
        title="Chi tiết Item — GR {itemDialog>/grNumber}"
        contentWidth="50rem">
        <customHeader>
            <Bar>
                <contentMiddle>
                    <Title text="Chi tiết item" level="H1" />
                </contentMiddle>
                <contentRight>
                    <HBox alignItems="Center" class="sapUiSmallMarginEnd">
                        <ObjectStatus text="{itemDialog>/totalItems} item"
                            state="Information"
                            class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{itemDialog>/validItems} ✓"
                            state="Success"
                            icon="sap-icon://accept"
                            class="sapUiSmallMarginEnd" />
                        <ObjectStatus text="{itemDialog>/invalidItems} ✕"
                            state="{itemDialog>/summaryState}"
                            icon="sap-icon://alert" />
                    </HBox>
                </contentRight>
            </Bar>
        </customHeader>
        <content>
            <Table id="grItemDetailTable" items="{gr>/GrItem}" noDataText="Không có item nào">
                <columns>
                    <Column id="_gidc1" width="4rem"><Text id="_gidt1" text="Item" /></Column>
                    <Column id="_gidc2" width="9rem"><Text id="_gidt2" text="PO Number" /></Column>
                    <Column id="_gidc3" width="5rem"><Text id="_gidt3" text="PO Item" /></Column>
                    <Column id="_gidc4" width="14rem"><Text id="_gidt4" text="Material" /></Column>
                    <Column id="_gidc5" width="6rem"><Text id="_gidt5" text="Plant" /></Column>
                    <Column id="_gidc6" width="7rem" hAlign="End"><Text id="_gidt6" text="Receive Qty" /></Column>
                    <Column id="_gidc7" width="5rem"><Text id="_gidt7" text="Unit" /></Column>
                    <Column id="_gidc8" width="9rem"><Text id="_gidt8" text="Status" /></Column>
                </columns>
                <items>
                    <ColumnListItem id="_giditem"
                        highlight="{= ${gr>Status} === 'E' ? 'Error' : 'None'}">
                        <cells>
                            <Text id="_gidcell1" text="{gr>Item}" />
                            <Text id="_gidcell2" text="{gr>PoNumber}" design="Monospace" wrapping="false" tooltip="{gr>PoNumber}" />
                            <Text id="_gidcell3" text="{gr>PoItem}" />
                            <Text id="_gidcell4" text="{gr>Material}" wrapping="false" tooltip="{gr>Material}" />
                            <Text id="_gidcell5" text="{gr>Plant}" />
                            <Text id="_gidcell6" text="{gr>ReceiveQty}" hAlign="End" />
                            <Text id="_gidcell7" text="{gr>Unit}" />
                            <ObjectStatus id="_gidcell8"
                                text="{gr>Status}"
                                state="{= ${gr>StatusCriticality} === 3 ? 'Success' : ${gr>StatusCriticality} === 1 ? 'Error' : 'None' }" />
                        </cells>
                    </ColumnListItem>
                </items>
            </Table>
            <Panel headerText="Các lỗi item" expandable="false"
                visible="{itemDialog>/hasErrors}"
                class="sapUiSmallMarginTop">
                <List id="_gidErrorList" items="{path:'itemDialog>/errors'}">
                    <items>
                        <StandardListItem title="{itemDialog>title}"
                            description="{itemDialog>description}"
                            type="Inactive" />
                    </items>
                </List>
            </Panel>
        </content>
        <beginButton>
            <Button id="_gidCloseBtn" text="Đóng" press=".onCloseItemDialog" />
        </beginButton>
    </Dialog>
</core:FragmentDefinition>
